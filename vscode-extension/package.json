{
  "name": "krishna-project",
  "displayName": "D.A.A.L",
  "description": "D.A.A.L diagnostics for Kubernetes YAML",
  "version": "0.1.2",
  "publisher": "krishnapandey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Krishna-10-7/daal.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "categories": [
    "Linters"
  ]
  ,
  "contributes": {
    "configuration": {
      "title": "D.A.A.L",
      "properties": {
        "daal.serverUrl": {
          "type": "string",
          "default": "https://r2-d2.xyz/compile",
          "description": "URL of the D.A.A.L server endpoint. Default: Azure VM via Caddy HTTPS. Fallback: http://20.193.254.214:3000/compile or http://localhost:3000/compile for local testing."
        }
      }
    },
    "commands": [
      {
        "command": "daal.runOnServer",
        "title": "DAAL: Run on Server"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "daal.runOnServer",
          "when": "editorLangId == yaml",
          "group": "navigation"
        }
      ]
    }
  }
}
