{
  "name": "krishna-project",
  "displayName": "D.A.A.L",
  "description": "D.A.A.L diagnostics for Kubernetes YAML",
  "version": "0.1.1",
  "publisher": "krishnapandey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Krishna-10-7/daal.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "categories": [
    "Linters"
  ]
  ,
  "contributes": {
    "configuration": {
      "title": "D.A.A.L",
      "properties": {
        "daal.serverUrl": {
          "type": "string",
          "default": "http://localhost:3000/compile",
          "description": "URL of the D.A.A.L server endpoint that accepts POST { text } and returns diagnostics. Leave empty to use local analysis."
        }
      }
    },
    "commands": [
      {
        "command": "daal.runOnServer",
        "title": "DAAL: Run on Server"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "daal.runOnServer",
          "when": "editorLangId == yaml",
          "group": "navigation"
        }
      ]
    }
  }
}
